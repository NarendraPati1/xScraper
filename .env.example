# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here  # Used for direct rank_and_notify script posting

# Twitter / X Scraper Credentials (Use a dedicated throwaway account!)
TWITTER_USERNAME=your_twitter_username_here
TWITTER_EMAIL=your_twitter_email_here
TWITTER_PASSWORD=your_twitter_password_here

# Session cookie replication (recommended for cloud hosts to avoid verification checks)
# Copy the string contents of cookies.json generated locally
TWITTER_COOKIES_JSON=

# Web Server Port (used by Render/Koyeb for healthcheck probes)
PORT=8000
